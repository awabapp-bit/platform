{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "isAdmin": {
          ".write": "!data.exists()"
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['sessionId', 'device', 'lastActive', 'createdAt'])"
      }
    },
    "competitions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$compId": {
        "lessons": {
          "$lessonId": {
            "videos": {
              "$videoId": {
                "comments": {
                  "$commentId": {
                    ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && !newData.child('adminReply').exists()))",
                    "adminReply": {
                      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
                    }
                  }
                }
              }
            },
            "exams": {
              "$examId": {
                ".read": "auth != null",
                ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
                "questions": {
                  ".read": "auth != null && (auth.uid === root.child('examAttempts').child($compId).child($lessonId).child($examId).child(auth.uid).child('started').val() || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
                  ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
                }
              }
            }
          }
        }
      }
    },
    "examBank": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$compId": {
        "$lessonId": {
          "$examId": {
            "questions": {
              ".read": "auth != null",
              ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
            }
          }
        }
      }
    },
    "examAttempts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$compId": {
        "$lessonId": {
          "$examId": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
              ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
              "answers": {
                ".validate": "newData.isNumber() || newData.isString()"
              },
              "violations": {
                ".validate": "newData.isNumber()"
              },
              "violationList": {
                ".validate": "newData.isArray()"
              },
              "submitted": {
                ".validate": "newData.isBoolean()"
              },
              "forceEnded": {
                ".validate": "newData.isBoolean()"
              },
              "startedAt": {
                ".validate": "newData.isNumber()"
              },
              "submittedAt": {
                ".validate": "newData.isNumber()"
              },
              "selectedQuestions": {
                ".validate": "newData.isArray()"
              },
              "sessionId": {
                ".validate": "newData.isString()"
              }
            }
          }
        }
      }
    },
    "violations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$violationId": {
          ".validate": "newData.hasChildren(['type', 'timestamp', 'examRef', 'details'])"
        }
      }
    },
    "userEnrollments": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userProgress": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "notifiedLessons": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "conversations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "messages": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "maxViolations": {
        ".validate": "newData.isNumber() && newData.val() >= 1"
      }
    }
  }
}